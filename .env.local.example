# ============================================================
# Community Portal – Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# For Vercel deployments, set these in your project's
# Environment Variables settings.


# ── Building Layout ────────────────────────────────────────
# Wings and flat/unit number ranges for all dropdowns in the app
# (registration, profile, issue forms, admin filters).
#
# Format: JSON array where each item has:
#   name       — wing label shown in the UI (e.g. "A", "Block 1", "North")
#   flatStart  — first unit number in that wing (inclusive)
#   flatEnd    — last unit number in that wing (inclusive)
#
# Numbers are zero-padded to 3 digits in dropdowns (1 → "001").
#
# Example — A/B/C wings:
#   NEXT_PUBLIC_WINGS_CONFIG='[{"name":"A","flatStart":1,"flatEnd":20},{"name":"B","flatStart":21,"flatEnd":40},{"name":"C","flatStart":41,"flatEnd":60}]'
#
# Example — single block, units 101–215:
#   NEXT_PUBLIC_WINGS_CONFIG='[{"name":"Main","flatStart":101,"flatEnd":215}]'
#
# If omitted, the app falls back to the Amber Meadows default layout (Wings A–E).
NEXT_PUBLIC_WINGS_CONFIG='[{"name":"A","flatStart":1,"flatEnd":9},{"name":"B","flatStart":10,"flatEnd":19},{"name":"C","flatStart":20,"flatEnd":33},{"name":"D","flatStart":34,"flatEnd":49},{"name":"E","flatStart":50,"flatEnd":57}]'


# ── White-label Branding ────────────────────────────────────
# These control every piece of visible branding — no code
# changes needed. Just update these vars and redeploy.

# The community/society name shown throughout the UI
NEXT_PUBLIC_COMMUNITY_NAME="My Community"

# Short subtitle shown under the logo in the sidebar
NEXT_PUBLIC_COMMUNITY_SUBTITLE="Residences"

# Path to your logo image (place file in the /public folder).
# Leave empty to use the default building icon instead.
# Examples: "/logo.png"  "/assets/my-society-logo.svg"
NEXT_PUBLIC_LOGO_PATH=""

# Browser meta description
NEXT_PUBLIC_APP_DESCRIPTION="Community portal"

# Label for individual units (used in nav, headings, forms)
# e.g. Villa | Flat | Apartment | Unit | House | Suite
NEXT_PUBLIC_UNIT_LABEL="Unit"

# Label for community members
# e.g. Resident | Owner | Member | Tenant
NEXT_PUBLIC_MEMBER_LABEL="Resident"

# Primary brand colour as bare HSL values (no hsl() wrapper).
# This re-themes buttons, links, active nav items, and badges.
#
# Presets:
#   Green  (default) : 142.1 76.2% 36.3%
#   Blue             : 221.2 83.2% 53.3%
#   Indigo           : 243.4 75.4% 58.6%
#   Orange           : 24.6 95% 53.1%
#   Red              : 0 84.2% 60.2%
#   Purple           : 270 67% 47%
#   Teal             : 174 62% 35%
NEXT_PUBLIC_PRIMARY_HSL="142.1 76.2% 36.3%"


# ── Database (Neon via Vercel Marketplace) ─────────────────
# These are injected automatically when you add a Neon database
# in your Vercel project's Storage tab.
DATABASE_URL=
DATABASE_URL_UNPOOLED=


# ── Auth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
AUTH_SECRET=


# ── Vercel Blob ────────────────────────────────────────────
# Injected automatically when you add a Blob store in Vercel Storage tab.
BLOB_READ_WRITE_TOKEN=


# ── App URL (update to your Vercel URL for production) ─────
NEXTAUTH_URL=http://localhost:3000
