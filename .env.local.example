# ============================================================
# Amber Meadows – Issue Tracker – Environment Vars
# ============================================================
# Copy this file to .env.local and fill in your values.
# All Postgres + Blob values are auto-populated by Vercel when
# you link a Storage resource to your project.

# ── Database (Vercel Postgres / Neon) ──────────────────────
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Vercel Blob ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── App URL (update for production) ──────────────────────
NEXTAUTH_URL=http://localhost:3000
