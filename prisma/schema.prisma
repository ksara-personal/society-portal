generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(RESIDENT)
  phone           String?
  wing            String?
  flatNo          String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  approvalStatus  UserStatus      @default(PENDING)
  approvedAt      DateTime?
  lastLoginAt     DateTime?
  contactsCreated Contact[]       @relation("ContactsCreated")
  assignedIssues  Issue[]         @relation("AssignedTo")
  createdIssues   Issue[]         @relation("CreatedBy")
  payments        Payment[]       @relation("PaymentResident")
  collectedPayments Payment[]     @relation("PaymentCollector")
  expenseItems    ExpenseItem[]   @relation("ExpenseItemsCreated")
  statusChanges   StatusHistory[]
  meetingsCreated Meeting[]       @relation("MeetingsCreated")

  @@index([email])
  @@index([role])
  @@index([approvalStatus])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]

  @@index([slug])
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expenseItems ExpenseItem[]

  @@index([slug])
}

model ExpenseType {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expenseItems ExpenseItem[]

  @@index([slug])
}

model PaymentType {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  payments  Payment[]

  @@index([slug])
}

model ExpenseItem {
  id                String          @id @default(cuid())
  date              DateTime        @db.Date
  description       String
  amount            Decimal         @db.Decimal(10, 2)
  createdById       String
  quarterId         String
  expenseCategoryId String
  expenseTypeId     String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  createdBy       User           @relation("ExpenseItemsCreated", fields: [createdById], references: [id])
  quarter         PaymentQuarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  expenseType     ExpenseType    @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([quarterId])
  @@index([expenseCategoryId])
  @@index([expenseTypeId])
}

model Issue {
  id            String          @id @default(cuid())
  title         String
  description   String
  status        IssueStatus     @default(PENDING)
  priority      Priority        @default(MEDIUM)
  wing          String?
  location      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  resolvedAt    DateTime?
  categoryId    String
  createdById   String
  assignedToId  String?
  flatNo        String?
  issueType     IssueType       @default(SOCIETY)
  attachments   Attachment[]
  assignedTo    User?           @relation("AssignedTo", fields: [assignedToId], references: [id])
  category      Category        @relation(fields: [categoryId], references: [id])
  createdBy     User            @relation("CreatedBy", fields: [createdById], references: [id])
  statusHistory StatusHistory[]

  @@index([status])
  @@index([categoryId])
  @@index([createdById])
  @@index([createdAt])
  @@index([wing])
  @@index([issueType])
}

model Attachment {
  id        String         @id @default(cuid())
  url       String
  type      AttachmentType
  filename  String
  size      Int
  createdAt DateTime       @default(now())
  issueId   String
  issue     Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model StatusHistory {
  id          String       @id @default(cuid())
  fromStatus  IssueStatus?
  toStatus    IssueStatus
  note        String?
  createdAt   DateTime     @default(now())
  issueId     String
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id])
  issue       Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([createdAt])
}

model ContactCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  color     String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]

  @@index([slug])
}

model Contact {
  id          String          @id @default(cuid())
  name        String
  type        ContactType     @default(INDIVIDUAL)
  companyName String?
  phone       String?         @unique
  altPhone    String?
  email       String?
  address     String?
  website     String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  categoryId  String
  createdById String
  category    ContactCategory @relation(fields: [categoryId], references: [id])
  createdBy   User            @relation("ContactsCreated", fields: [createdById], references: [id])

  @@index([categoryId])
  @@index([createdById])
  @@index([name])
}

model PaymentQuarter {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  year          Int
  order         Int       @default(0)
  defaultAmount Decimal   @default(0.00) @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
  expenseItems  ExpenseItem[]

  @@index([year])
  @@index([isActive])
  @@index([order])
}

model Flat {
  id                     String   @id @default(cuid())
  wing                   String
  flatNo                 String
  eligibleForMaintenance Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([wing, flatNo])
  @@index([wing])
  @@index([eligibleForMaintenance])
}

model Payment {
  id            String         @id @default(cuid())
  amount        Decimal        @db.Decimal(10, 2)
  status        PaymentStatus  @default(PENDING)
  quarterId     String
  paymentTypeId String?
  userId        String?
  wing          String
  flatNo        String
  paidAt        DateTime?
  paymentMethod String?
  transactionId String?
  notes         String?
  collectedById String?
  collectedBy   User?          @relation("PaymentCollector", fields: [collectedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  quarter       PaymentQuarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  paymentType   PaymentType?   @relation(fields: [paymentTypeId], references: [id])
  user          User?          @relation("PaymentResident", fields: [userId], references: [id])

  @@index([status])
  @@index([quarterId])
  @@index([paymentTypeId])
  @@index([userId])
  @@index([collectedById])
  @@index([wing, flatNo])
  @@index([createdAt])
}

model Meeting {
  id          String        @id @default(cuid())
  title       String
  content     String        @db.Text
  meetingDate DateTime
  year        Int
  status      MeetingStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String
  createdBy   User          @relation("MeetingsCreated", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([year])
  @@index([status])
  @@index([meetingDate])
}

enum Role {
  ADMIN
  RESIDENT
}

enum IssueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum IssueType {
  SOCIETY
  VILLA
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentType {
  IMAGE
  VIDEO
}

enum ContactType {
  INDIVIDUAL
  COMPANY
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
  PARTIAL
}

enum MeetingStatus {
  DRAFT
  PUBLISHED
}
